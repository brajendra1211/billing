PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=urgent_billing
DB_PORT=3306
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Email (SMTP) - e.g. Gmail: smtp.gmail.com, port 587, use an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Daily reminders / renewal alerts (cron, Asia/Kolkata). DISABLE_CRON=1 to turn off.
NOTIFY_CRON=0 9 * * *
DISABLE_CRON=0
